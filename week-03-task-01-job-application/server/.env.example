# Copy to .env and fill in your own MongoDB connection string.
# Do NOT commit the real .env — it's already in .gitignore.
# If SRV lookups fail on your network (as they did in previous tasks),
# use the non-SRV connection string from Atlas's "Drivers" tab instead.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/job-applications
PORT=5000
