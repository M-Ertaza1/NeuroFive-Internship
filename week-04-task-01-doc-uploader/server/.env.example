# Copy to .env and fill in your own values.
# Do NOT commit the real .env — it's already in .gitignore.

# Reuse the same MongoDB connection string from previous tasks
# (use the non-SRV format if the standard one fails on your network).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/doc-uploader
PORT=5000

# From your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
